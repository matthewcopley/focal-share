# Focal configuration — copy this file to `.env` and fill in what you use.
# Everything here is OPTIONAL. Focal works out of the box with no .env at all;
# these settings only enable the optional AI (AWS Bedrock) and wiki features.

# ── AWS Bedrock (optional AI backend) ────────────────────────────────────────
# Only needed if you select "Bedrock" as the AI backend in Settings.
# The model ID is a Bedrock model or inference-profile ID enabled in your
# AWS account (see the Bedrock console → Model access).
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=us-east-1
#BEDROCK_MODEL_ID=

# ── Wiki integration (optional) ──────────────────────────────────────────────
# Root folder of a personal markdown wiki. Pages are read from <root>/wiki/*.md
# and AI daily summaries are written to <root>/raw/focal/.
#FOCAL_WIKI_ROOT=~/Documents/focal-wiki

# Wiki server auto-shutdown after N minutes idle (0 = never)
#WIKI_IDLE_MINUTES=30
