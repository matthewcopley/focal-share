# Focal configuration — copy this file to `.env` if you want to change anything.
# Everything here is OPTIONAL. Focal works out of the box with no .env at all;
# these settings only affect the optional wiki integration.
#
# (AI is configured in the app itself: Settings → AI endpoint / API key / model.)

# Root folder of a personal markdown wiki. Pages are read from <root>/wiki/*.md
# and AI daily summaries are written to <root>/raw/focal/.
#FOCAL_WIKI_ROOT=~/Documents/focal-wiki

# Wiki server auto-shutdown after N minutes idle (0 = never)
#WIKI_IDLE_MINUTES=30
